# Copy this file to .env and adjust as needed.
# `docker compose up` reads .env automatically.

# --- Postgres ---
POSTGRES_USER=openxc
POSTGRES_PASSWORD=openxc
POSTGRES_DB=openxc
POSTGRES_PORT=5432

# --- Backend API ---
# Exposed directly in addition to nginx, mainly for the interactive API docs
# at http://localhost:${BACKEND_PORT}/docs (nginx only proxies /api).
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins, or "*" for any.
# Only relevant if you call the API directly (bypassing nginx/the frontend).
CORS_ORIGINS=*
# Set to "true" to auto-populate a demo meet with races, athletes, and
# sample results the first time the database is created.
SEED_DEMO_DATA=true

# --- Valkey ---
# Every tag read gets XADD'ed to a Valkey stream (see backend/app/tag_stream.py)
# for diagnostics/external consumption. Published to the host specifically so
# it can be inspected directly: `valkey-cli -h localhost XRANGE tag_reads - +`.
VALKEY_PORT=6379

# --- nginx (reverse proxy) ---
# The app's main entry point: frontend on /, backend on /api. Change this if
# port 80 is already taken on your machine.
HTTP_PORT=80

# --- Dashboard passcode ---
# Simple shared passcode gating the operator dashboard (meet/team/athlete/
# timing management). The public results pages and the API itself are NOT
# protected by this — it's just a lightweight deterrent against a stray
# spectator poking at the sidebar, not real authentication.
DASHBOARD_PASSCODE=1234

# --- Starter module (optional hardware integration) ---
# Only used if you run `docker compose --profile starter up` — see
# starter/README.md. Leave blank (recommended) to post starting-gun events
# to whichever meet is marked "active" in the dashboard sidebar; set to a
# specific meet id/slug to always post there regardless of that toggle.
STARTER_MEET_ID=
